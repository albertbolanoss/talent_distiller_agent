# --- labs_agent_lib.AgentSettings (prefix: LABS_AGENT_LIB_) ---

# Which gateway provider to route through (portkey, anthropic) - defaults to portkey
LABS_AGENT_LIB_PROVIDER=portkey

# Log verbosity (DEBUG, INFO, WARNING, ERROR) - defaults to INFO
LABS_AGENT_LIB_LOG_LEVEL=INFO

# Portkey workspace key — get it from your AI Academy facilitator
LABS_AGENT_LIB_PORTKEY_API_KEY=

# Provider/credential alias configured in the Portkey dashboard (e.g. "aws-bedrock-use2")
LABS_AGENT_LIB_PORTKEY_VIRTUAL=

# Direct Anthropic API key (only needed when PROVIDER=anthropic).
LABS_AGENT_LIB_ANTHROPIC_API_KEY=

# Disables Anthropic prompt caching (cache_control) for the agent's requests. Enable
# (true) during development when iterating on the system prompt - defaults to false
LABS_AGENT_LIB_DISABLE_PROMPT_CACHING=false

# --- candidate_match_agent_cli.settings.Settings (prefix: CANDIDATE_MATCH_AGENT_) ---

# Directory main.py polls for resume files - defaults to "resume"
CANDIDATE_MATCH_AGENT_RESUME_DIR=resume

# How often (in seconds) main.py polls resume_dir for files - defaults to 300
CANDIDATE_MATCH_AGENT_RESUME_POLL_INTERVAL_SECONDS=300

# Max resume files processed per polling batch - defaults to 3
CANDIDATE_MATCH_AGENT_RESUME_MAX_FILES_PER_BATCH=3

# --- candidate_match_agent_cli.storage.RedisSettings (prefix: CANDIDATE_MATCH_AGENT_REDIS_) ---
# Connection for the resume-extraction job store (candidate_match_agent_cli.storage.RedisJobStore)

# Redis host - defaults to localhost
CANDIDATE_MATCH_AGENT_REDIS_HOST=localhost

# Redis auth password, only needed if your instance requires one - defaults to no auth
CANDIDATE_MATCH_AGENT_REDIS_PASSWORD=

# Redis logical database index - defaults to 0
CANDIDATE_MATCH_AGENT_REDIS_DB=0

# --- Server ---

# Port the resume-upload API server (candidate-match-agent-api) listens on - defaults to 8080.
# Unprefixed since it's a plain server setting, not part of any Settings model.
PORT=8080
