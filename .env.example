# Which gateway provider to route through (portkey, anthropic)
CANDIDATE_MATCH_AGENT_PROVIDER=portkey

# Log verbosity (DEBUG, INFO, WARNING, ERROR) - defaults to INFO
CANDIDATE_MATCH_AGENT_LOG_LEVEL=INFO

# Portkey workspace key — get it from your AI Academy facilitator
CANDIDATE_MATCH_AGENT_PORTKEY_API_KEY=

# Portkey virtual key (provider/credential alias configured in the Portkey dashboard,
# e.g. "aws-bedrock-use2"). Required when PROVIDER=portkey — the gateway rejects
# requests with a 400 if it's missing.
CANDIDATE_MATCH_AGENT_PORTKEY_VIRTUAL_KEY=

# Direct Anthropic API key (only needed when PROVIDER=anthropic).
CANDIDATE_MATCH_AGENT_ANTHROPIC_API_KEY=
