# --- labs_agent_lib.AgentSettings (prefix: LABS_AGENT_LIB_) ---

# Which gateway provider to route through (portkey, anthropic) - defaults to portkey
LABS_AGENT_LIB_PROVIDER=portkey

# Log verbosity (DEBUG, INFO, WARNING, ERROR) - defaults to INFO
LABS_AGENT_LIB_LOG_LEVEL=INFO

# Portkey workspace key — get it from your AI Academy facilitator
LABS_AGENT_LIB_PORTKEY_API_KEY=

# Provider/credential alias configured in the Portkey dashboard (e.g. "aws-bedrock-use2")
LABS_AGENT_LIB_PORTKEY_VIRTUAL=

# Direct Anthropic API key (only needed when PROVIDER=anthropic).
LABS_AGENT_LIB_ANTHROPIC_API_KEY=

# Disables Anthropic prompt caching (cache_control) for the agent's requests. Enable
# (true) during development when iterating on the system prompt - defaults to false
LABS_AGENT_LIB_DISABLE_PROMPT_CACHING=false

# --- talent_distiller_agent.settings.Settings: Resume settings (prefix: TALENT_DISTILLER_AGENT_) ---

# Directory main.py polls for resume files - defaults to "resume"
TALENT_DISTILLER_AGENT_RESUME_DIR=resume

# How often (in seconds) main.py polls resume_dir for files - defaults to 10
TALENT_DISTILLER_AGENT_RESUME_POLL_INTERVAL_SECONDS=10

# Max resume files processed per polling batch - defaults to 3
TALENT_DISTILLER_AGENT_RESUME_MAX_FILES_PER_BATCH=3

# Folder processed resumes are moved to - defaults to "<RESUME_DIR>/processed"
TALENT_DISTILLER_AGENT_COORDINATOR_PROCESSED_FOLDER=

# Folder resumes are moved to once COORDINATOR_MAX_REVISION_NUMBER is exceeded - defaults to "<RESUME_DIR>/failed"
TALENT_DISTILLER_AGENT_COORDINATOR_FAILED_FOLDER=

# --- talent_distiller_agent.settings.Settings: Job Posting settings (prefix: TALENT_DISTILLER_AGENT_) ---

# Directory main.py polls for job posting files - defaults to "job_posting"
TALENT_DISTILLER_AGENT_JOB_POSTING_DIR=job_posting

# How often (in seconds) main.py polls job_posting_dir for files - defaults to 10
TALENT_DISTILLER_AGENT_JOB_POSTING_POLL_INTERVAL_SECONDS=10

# Max job posting files processed per polling batch - defaults to 3
TALENT_DISTILLER_AGENT_JOB_POSTING_MAX_FILES_PER_BATCH=3

# Folder processed job postings are moved to - defaults to "<JOB_POSTING_DIR>/processed"
TALENT_DISTILLER_AGENT_JOB_POSTING_PROCESSED_FOLDER=

# Folder job postings are moved to once COORDINATOR_MAX_REVISION_NUMBER is exceeded - defaults to "<JOB_POSTING_DIR>/failed"
TALENT_DISTILLER_AGENT_JOB_POSTING_FAILED_FOLDER=

# --- talent_distiller_agent.settings.Settings: Shared MCP & Coordinator settings (prefix: TALENT_DISTILLER_AGENT_) ---

# URL of the candidate-skill-agent MCP server (streamable HTTP transport, must end in /mcp) -
# defaults to "http://127.0.0.1:8000/mcp". Run it from the sibling `candidate-skill-agent` repo:
#   uv run python -m mcp_skills_extractor_agents.main --protocol http --host 127.0.0.1 --port 8000
TALENT_DISTILLER_AGENT_SKILL_AGENT_MCP_URL=http://127.0.0.1:8000/mcp

# Model used by the coordinator agent - defaults to "us.anthropic.claude-haiku-4-5-20251001-v1:0"
TALENT_DISTILLER_AGENT_COORDINATOR_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Max extraction revisions before a file is marked failed - defaults to 3
TALENT_DISTILLER_AGENT_COORDINATOR_MAX_REVISION_NUMBER=3

# --- talent_distiller_agent.settings.Settings: Redis (prefix: TALENT_DISTILLER_AGENT_REDIS_) ---
# Connection for the resume-extraction job store (talent_distiller_agent.storage.RedisJobStore)

# Redis host - defaults to localhost
TALENT_DISTILLER_AGENT_REDIS_HOST=localhost

# Redis auth password, only needed if your instance requires one - defaults to no auth
TALENT_DISTILLER_AGENT_REDIS_PASSWORD=

# Redis logical database index - defaults to 0
TALENT_DISTILLER_AGENT_REDIS_DB=0

# --- Server ---

# Port the resume-upload API server (talent-distiller-agent-api) listens on - defaults to 8080.
# Unprefixed since it's a plain server setting, not part of any Settings model.
PORT=8080
